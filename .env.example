# osint-ai runtime configuration
# Copy to .env.local and fill in the provider(s) you use.

# ── LLM provider ─────────────────────────────────────────────────────────────
# Choose: openai, claude-code, codex-cli, pi, or antigravity. Leave blank to auto-detect:
# OpenAI-compatible settings select openai; otherwise claude-code is used.
LLM_PROVIDER=

# ── OpenAI-compatible API ────────────────────────────────────────────────────
# Works with OpenAI, DeepSeek, Gemini, Ollama, Groq, and similar providers.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Leave blank to use the role-based defaults in src/config/models.ts.
OPENAI_MODEL=

# ── Claude Code CLI ──────────────────────────────────────────────────────────
# Uses your local Claude Code login/subscription; no API key is required here.
CLAUDE_CODE_BIN=claude
CLAUDE_CODE_MODEL=
CLAUDE_CODE_TIMEOUT_MS=480000
# Set to 0 to use the fallback ReAct web tools instead of Firecrawl MCP.
CLAUDE_CODE_WEB_VIA_MCP=1

# ── Codex CLI ────────────────────────────────────────────────────────────────
# Uses your local Codex CLI login/subscription.
CODEX_CLI_BIN=codex
CODEX_CLI_MODEL=
CODEX_CLI_TIMEOUT_MS=480000
CODEX_CLI_SANDBOX=read-only

# ── Pi CLI ────────────────────────────────────────────────────────────────────
# Uses your local Pi coding agent session/auth; no API key required here.
PI_BIN=pi
PI_MODEL=
PI_PROVIDER=
PI_THINKING=
PI_TIMEOUT_MS=480000

# ── Antigravity CLI ───────────────────────────────────────────────────────────
# Uses your local Antigravity (agy) session; no API key required here.
# ANTIGRAVITY_BIN / AGY_BIN selects the binary; AGY_* aliases are accepted.
ANTIGRAVITY_BIN=agy
ANTIGRAVITY_MODEL=
ANTIGRAVITY_EFFORT=
ANTIGRAVITY_TIMEOUT_MS=480000

# ── Optional enrichment ──────────────────────────────────────────────────────
# Required for hosted Firecrawl. Self-hosted instances may not need a key.
FIRECRAWL_API_KEY=
# Self-hosted URLs must include /v2 (for example, http://localhost:3002/v2).
FIRECRAWL_API_URL=https://api.firecrawl.dev/v2
# FIRECRAWL_BASE_URL is accepted as an alias for FIRECRAWL_API_URL.

# Optional: enables LinkedIn enrichment via Browser Use.
BROWSER_USE_API_KEY=

# Optional: dashboard server port (defaults to 4173; PORT is also supported).
DASHBOARD_PORT=4173
